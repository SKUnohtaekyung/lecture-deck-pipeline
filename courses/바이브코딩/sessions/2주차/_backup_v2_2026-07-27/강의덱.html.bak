  </div>

  <!-- 발표 리모컨 + 상세 메뉴 (불변요소 · 브라우저 검증된 엔진) -->
  <div class="controls" id="controls">
    <div class="navbar">
      <button class="nav-btn" id="prevBtn" aria-label="이전 슬라이드">‹</button>
      <button class="nav-counter" id="counter" aria-label="상세 발표 메뉴 열기" aria-expanded="false">1 / 1</button>
      <button class="nav-btn" id="nextBtn" aria-label="다음 슬라이드">›</button>
      <span class="nav-sep"></span>
      <button class="nav-btn menu" id="menuBtn" aria-label="상세 발표 메뉴 열기" aria-expanded="false" title="상세 메뉴 (G)">☰</button>
      <button class="nav-btn fs" id="fsBtn" aria-label="전체화면 (F)" title="전체화면 (F)">⛶</button>
    </div>
  </div>
  <section class="presentation-menu" id="presentationMenu" role="dialog" aria-label="발표 상세 메뉴" hidden>
    <div class="menu-head">
      <div><p class="menu-eyebrow" id="menuPart">현재 슬라이드</p><p class="menu-title" id="menuTitle">슬라이드 제목</p></div>
      <button class="menu-close" id="menuClose" aria-label="상세 메뉴 닫기">×</button>
    </div>
    <div class="menu-actions">
      <button class="menu-action" id="homeBtn" aria-label="표지로 이동" title="홈">⌂</button>
      <label class="page-jump" aria-label="페이지 번호로 이동"><input id="pageInput" type="number" min="1" inputmode="numeric" placeholder="페이지 번호"><button class="menu-go" id="goBtn">이동</button></label>
      <button class="menu-action" id="pdfBtn" aria-label="PDF로 출력">PDF</button>
      <button class="menu-action" id="helpBtn" aria-label="단축키 안내" title="단축키">?</button>
    </div>
    <div class="slide-list" id="slideList" aria-label="전체 슬라이드 목록"></div>
  </section>
  <section class="keyboard-help" id="keyboardHelp" role="dialog" aria-label="발표 단축키" hidden>
    <button class="menu-close" id="helpClose" aria-label="단축키 안내 닫기">×</button>
    <h2>발표 단축키</h2>
    <dl><dt>← / →</dt><dd>이전·다음 슬라이드</dd><dt>Home / End</dt><dd>표지·마지막으로 이동</dd><dt>G</dt><dd>상세 메뉴 열기</dd><dt>B</dt><dd>화면 가리기</dd><dt>F</dt><dd>전체화면</dd><dt>?</dt><dd>이 안내 열기</dd><dt>Esc</dt><dd>열린 창 또는 화면 가리기 닫기</dd></dl>
  </section>
  <div class="presentation-blackout" id="blackout" aria-label="화면 가리기, 클릭하면 해제" hidden></div>

  <script>
  (function(){
    function partGeometry(n){
      var presets={
        1:[[640,126,92,92]],
        2:[[560,150,60,60],[640,230,70,70]],
        3:[[670,136,58,58],[584,228,58,58],[756,228,58,58]],
        4:[[620,94,58,58],[726,158,66,66],[522,188,50,50],[628,264,48,48]],
        5:[[640,78,48,48],[532,146,62,62],[730,142,46,46],[574,258,48,48],[694,238,64,64]],
        6:[[610,70,42,42],[510,138,56,56],[724,122,52,52],[466,246,40,40],[604,214,66,66],[764,246,44,44]]
      }, points=presets[n]&&presets[n].slice();
      if(!points){
        points=[];
        var size=Math.max(28,44-Math.floor((n-7)/2));
        for(var i=0;i<n;i++){
          var angle=-Math.PI/2+(Math.PI*2*i/n), ring=i%2?1:.72;
          points.push([640+Math.cos(angle)*150*ring,178+Math.sin(angle)*82*ring+(i%3)*12,size,size]);
        }
      }
      return points.sort(function(a,b){return a[1]-b[1];});
    }
    function cubeMarkup(p,i){
      var x=Math.round(p[0]),y=Math.round(p[1]),w=Math.round(p[2]),d=Math.round(p[3]),h=Math.round(w/2);
      return '<g class="pd-cube pd-cube-'+(i+1)+'" data-cube="'+(i+1)+'">'+
        '<ellipse class="pd-cube-shadow" cx="'+x+'" cy="'+(y+w+d+9)+'" rx="'+Math.round(w*.72)+'" ry="'+Math.max(6,Math.round(w*.17))+'"/>'+
        '<polygon points="'+x+','+y+' '+(x+w)+','+(y+h)+' '+x+','+(y+w)+' '+(x-w)+','+(y+h)+'" fill="var(--blue-soft)"/>'+
        '<polygon points="'+(x-w)+','+(y+h)+' '+x+','+(y+w)+' '+x+','+(y+w+d)+' '+(x-w)+','+(y+h+d)+'" fill="var(--blue)"/>'+
        '<polygon points="'+x+','+(y+w)+' '+(x+w)+','+(y+h)+' '+(x+w)+','+(y+h+d)+' '+x+','+(y+w+d)+'" fill="var(--mint)"/></g>';
    }
    function hydratePartDivider(s,index,total){
      var hero=s.querySelector('.dv-hero'), points=partGeometry(index), html='';
      for(var i=0;i<points.length;i++)html+=cubeMarkup(points[i],i);
      if(hero){hero.innerHTML=html+'<circle class="pd-spark" cx="820" cy="112" r="7"/>';hero.setAttribute('data-geometry-count',index);}
      var dots=s.querySelector('.pd-dots'), dotHtml='';
      for(var d=1;d<=total;d++)dotHtml+='<span class="pd-dot'+(d===index?' is-active':'')+'"></span>';
      if(dots)dots.innerHTML=dotHtml;
      var eyebrow=s.querySelector('.pd-eyebrow');if(eyebrow)eyebrow.textContent='PART '+index+' / '+total;
      s.setAttribute('data-part-index',index);s.setAttribute('data-part-total',total);
    }
    var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
    var totalParts = 0;
    slides.forEach(function(s){ if (/\bpart-divider\b/.test(s.className)) totalParts++; });
    var curPart = 0;
    slides.forEach(function(s, i){
      if (/\bpart-divider\b/.test(s.className)) { curPart++; hydratePartDivider(s, curPart, totalParts); }
      var fixed = /\b(cover|s02-slide|s03-slide|part-divider|concept-recap|closing)\b/.test(s.className);
      if (!/\b(cover|concept-recap|closing)\b/.test(s.className)) {
        var pg = document.createElement('div');
        pg.className = 's-pageno';
        pg.textContent = (i + 1) + ' / ' + slides.length;
        s.appendChild(pg);
      }
      if (!fixed && curPart >= 1 && totalParts >= 1) {
        var team = s.querySelector('.s-head .s-team');
        if (team) {
          var h = '<span class="lbl">PART ' + curPart + ' / ' + totalParts + '</span><span class="dots">';
          for (var d = 1; d <= totalParts; d++) h += '<span class="pd' + (d === curPart ? ' on' : '') + '"></span>';
          team.className = 's-part';
          team.innerHTML = h + '</span>';
        }
      }
    });
    var controls = document.getElementById('controls');
    var counter  = document.getElementById('counter');
    var prevBtn  = document.getElementById('prevBtn');
    var nextBtn  = document.getElementById('nextBtn');
    var fsBtn    = document.getElementById('fsBtn');
    var menuBtn  = document.getElementById('menuBtn');
    var menu     = document.getElementById('presentationMenu');
    var menuClose = document.getElementById('menuClose');
    var homeBtn  = document.getElementById('homeBtn');
    var pageInput = document.getElementById('pageInput');
    var goBtn    = document.getElementById('goBtn');
    var pdfBtn   = document.getElementById('pdfBtn');
    var helpBtn  = document.getElementById('helpBtn');
    var help     = document.getElementById('keyboardHelp');
    var helpClose = document.getElementById('helpClose');
    var blackout = document.getElementById('blackout');
    var slideList = document.getElementById('slideList');
    var menuTitle = document.getElementById('menuTitle');
    var menuPart = document.getElementById('menuPart');
    var idx = 0, hideTimer = null;
    var storageKey = 'vibecoding-week2';

    function initialIndex(){
      var m = String(location.hash || '').match(/slide=(\d+)/i);
      if (m) return Math.max(0, parseInt(m[1], 10) - 1);
      try { var saved = parseInt(localStorage.getItem(storageKey), 10); return isNaN(saved) ? 0 : saved; }
      catch (e) { return 0; }
    }
    function fit(){
      var s = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
      document.documentElement.style.setProperty('--scale', s);
    }
    function show(i){
      idx = Math.max(0, Math.min(slides.length - 1, i));
      for (var n = 0; n < slides.length; n++){ slides[n].classList.toggle('is-active', n === idx); }
      counter.textContent = (idx + 1) + ' / ' + slides.length;
      prevBtn.disabled = (idx === 0);
      nextBtn.disabled = (idx === slides.length - 1);
      updateMenu();
      try { localStorage.setItem(storageKey, String(idx)); } catch (e) {}
      try { history.replaceState(null, '', '#slide=' + (idx + 1)); } catch (e) {}
    }
    function next(){ show(idx + 1); }
    function prev(){ show(idx - 1); }
    function slideName(s, i){
      var heading = s.querySelector('h1,h2,h3');
      var text = heading ? heading.textContent.replace(/\s+/g, ' ').trim() : '';
      return text || s.getAttribute('data-slide') || ('슬라이드 ' + (i + 1));
    }
    function slidePart(s){
      var el = s.querySelector('.s-part .lbl');
      return el ? el.textContent : (s.classList.contains('cover') ? '표지' : '발표 슬라이드');
    }
    function buildSlideList(){
      slides.forEach(function(s, i){
        var btn = document.createElement('button');
        var number = document.createElement('span');
        var label = document.createElement('span');
        btn.type = 'button'; btn.dataset.slideIndex = i;
        number.className = 'list-num'; number.textContent = String(i + 1).padStart(3, '0');
        label.textContent = slideName(s, i); btn.appendChild(number); btn.appendChild(label);
        btn.addEventListener('click', function(){ show(i); closeMenu(); poke(); });
        slideList.appendChild(btn);
      });
    }
    function updateMenu(){
      var current = slides[idx];
      menuTitle.textContent = slideName(current, idx);
      menuPart.textContent = slidePart(current);
      pageInput.value = idx + 1;
      Array.prototype.forEach.call(slideList.children, function(btn, i){ btn.classList.toggle('is-current', i === idx); });
    }
    function openMenu(){
      menu.hidden = false; help.hidden = true; blackout.hidden = true;
      menuBtn.setAttribute('aria-expanded', 'true'); counter.setAttribute('aria-expanded', 'true');
      controls.classList.add('show'); clearTimeout(hideTimer); updateMenu();
      setTimeout(function(){ pageInput.focus(); pageInput.select(); }, 0);
    }
    function closeMenu(){
      menu.hidden = true; menuBtn.setAttribute('aria-expanded', 'false'); counter.setAttribute('aria-expanded', 'false');
      poke();
    }
    function toggleMenu(){ menu.hidden ? openMenu() : closeMenu(); }
    function openHelp(){ help.hidden = false; menu.hidden = true; menuBtn.setAttribute('aria-expanded', 'false'); counter.setAttribute('aria-expanded', 'false'); controls.classList.add('show'); clearTimeout(hideTimer); helpClose.focus(); }
    function closeHelp(){ help.hidden = true; poke(); }
    function jumpToInput(){ var n = parseInt(pageInput.value, 10); if (!isNaN(n)) { show(n - 1); closeMenu(); } }
    function toggleBlackout(){ blackout.hidden = !blackout.hidden; if (blackout.hidden) poke(); }
    function poke(){ controls.classList.add('show'); clearTimeout(hideTimer);
      if (!menu.hidden || !help.hidden || !blackout.hidden) return;
      hideTimer = setTimeout(function(){ controls.classList.remove('show'); }, 1000); }
    function toggleFullscreen(){
      if (!document.fullscreenElement){ (document.documentElement.requestFullscreen || function(){}).call(document.documentElement); }
      else { (document.exitFullscreen || function(){}).call(document); }
    }
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') { if (!blackout.hidden) { blackout.hidden = true; } else if (!help.hidden) { closeHelp(); } else if (!menu.hidden) { closeMenu(); } return; }
      if ((e.key === 'g' || e.key === 'G') && !e.ctrlKey && !e.metaKey) { toggleMenu(); e.preventDefault(); return; }
      if (e.key === '?' && !e.ctrlKey && !e.metaKey) { openHelp(); e.preventDefault(); return; }
      if ((e.key === 'b' || e.key === 'B') && !e.ctrlKey && !e.metaKey) { toggleBlackout(); e.preventDefault(); return; }
      if (!menu.hidden || !help.hidden || !blackout.hidden) return;
      switch (e.key){
        /* 슬라이드 전환은 리모컨을 노출하지 않는다 — 리모컨은 마우스 이동(mousemove→poke)에만 나타난다. */
        case 'ArrowRight': case 'PageDown': case ' ': case 'Spacebar': next(); e.preventDefault(); break;
        case 'ArrowLeft': case 'PageUp': prev(); e.preventDefault(); break;
        case 'Home': show(0); e.preventDefault(); break;
        case 'End':  show(slides.length - 1); e.preventDefault(); break;
        case 'f': case 'F': toggleFullscreen(); break;
      }
    });
    prevBtn.addEventListener('click', function(){ prev(); poke(); });
    nextBtn.addEventListener('click', function(){ next(); poke(); });
    fsBtn.addEventListener('click', function(e){ e.stopPropagation(); toggleFullscreen(); poke(); });
    menuBtn.addEventListener('click', function(e){ e.stopPropagation(); toggleMenu(); });
    counter.addEventListener('click', function(e){ e.stopPropagation(); toggleMenu(); });
    menuClose.addEventListener('click', closeMenu);
    homeBtn.addEventListener('click', function(){ show(0); closeMenu(); });
    goBtn.addEventListener('click', jumpToInput);
    pageInput.addEventListener('keydown', function(e){ if (e.key === 'Enter') { jumpToInput(); e.preventDefault(); } });
    pdfBtn.addEventListener('click', function(){ window.print(); });
    helpBtn.addEventListener('click', openHelp);
    helpClose.addEventListener('click', closeHelp);
    blackout.addEventListener('click', toggleBlackout);
    document.addEventListener('fullscreenchange', fit);
    window.addEventListener('mousemove', poke);
    window.addEventListener('resize', fit);
    buildSlideList();
    fit(); show(initialIndex()); poke();
  })();
  </script>
</body>
</html>
