        <div class="accent-bar"></div>
        <span class="pill" style="font-size:13px; margin-bottom:8px;">채택 미정 · 비교용</span>
        <table class="t">
          <thead>
            <tr><th style="width:130px;">유형</th><th>대표 동작</th><th style="width:110px;">상대 난이도</th><th>대표 실패</th><th style="width:150px;">3주차 저장 연결</th></tr>
