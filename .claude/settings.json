{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read",
      "Grep",
      "Glob",
      "Bash(python -m http.server:*)",
      "Bash(python -m scripts.aggregate_benchmark:*)",
      "Bash(python -m scripts.quick_validate:*)",
      "Bash(python -m scripts.package_skill:*)",
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(taskkill:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hook_slide_guard.py\" --mode checklist",
            "timeout": 15,
            "statusMessage": "슬라이드 사전 점검 7항 확인"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hook_slide_guard.py\" --mode course",
            "timeout": 15,
            "statusMessage": "과목 슬라이드 지침 주입"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hook_slide_guard.py\" --mode generated-guard",
            "timeout": 15,
            "statusMessage": "생성물 직접 편집 검사 (관측)"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hook_slide_guard.py\" --mode tmp-guard",
            "timeout": 15,
            "statusMessage": "저장소 밖 쓰기 검사 (관측)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hook_slide_guard.py\" --mode css-lint",
            "timeout": 15,
            "statusMessage": "R-QC-14 CSS 회귀 검사"
          }
        ]
      }
    ]
  }
}
